# Variables de entorno del sistema. Copie este archivo como .env y cambie los valores:
#   cp .env.example .env
# El archivo .env está en .gitignore y nunca se sube al repositorio.
# En el pipeline estos valores salen de GitHub Secrets y de las variables del environment.

# ---------- Base de datos ----------
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=cambie-esta-clave-local

# ---------- Usuarios de la API (claves de al menos 12 caracteres) ----------
GESTOR_USUARIO=gestor
GESTOR_CLAVE=cambie-esta-clave-gestor
CONSULTA_USUARIO=consulta
CONSULTA_CLAVE=cambie-esta-clave-consulta

# ---------- Imagen que se ejecuta ----------
# Local: la construye docker compose up --build. En el despliegue: ghcr.io/<usuario>/<repositorio>:<tag>
APP_IMAGE=reservas:local
